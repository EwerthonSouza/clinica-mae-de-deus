# Aumenta os limites de upload do PHP (funciona em hospedagens com mod_php;
# em hospedagens com PHP-FPM, ajuste isso pelo painel/php.ini em vez daqui).
<IfModule mod_php.c>
  php_value upload_max_filesize 100M
  php_value post_max_size 105M
  php_value memory_limit 256M
  php_value max_execution_time 120
</IfModule>

# Impede listagem de pastas
Options -Indexes

# Compressão (deixa o site mais leve pra carregar)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache no navegador (o visitante não baixa de novo o que não mudou)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|jpg|jpeg|png|webp|gif|mp4|webm|mov)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
